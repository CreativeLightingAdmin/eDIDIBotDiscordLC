# Copy this file to `.env` and fill in your values. NEVER commit the real .env.

# --- Discord (required) ---
DISCORD_TOKEN=your-bot-token-here
DISCORD_CLIENT_ID=your-application-id
# Only needed for fast guild-scoped command deploys (npm run deploy:guild)
DISCORD_GUILD_ID=your-test-server-id

# --- Controller (optional) ---
# If set, /connect can be used without an IP argument.
EDIDIO_IP=192.168.0.91
EDIDIO_PORT=23
# TLS port for newer controllers (used when /connect tls:true).
EDIDIO_TLS_PORT=443

# --- Access control (optional) ---
# Comma-separated Discord role IDs allowed to run control commands.
# Leave blank to allow everyone (fine for a private server).
CONTROL_ROLE_IDS=

# Heartbeat interval in milliseconds (keep-alive to the controller).
HEARTBEAT_MS=7000
